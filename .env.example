# Server Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
POSTGRES_USER=mediflow_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=mediflow_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=prefer

# Authentication & JWT Configuration
# Note: Generate a high-entropy secret in production (e.g. `openssl rand -hex 64`)
JWT_SECRET=replace_with_a_cryptographically_secure_256_bit_secret
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_another_cryptographically_secure_secret
JWT_REFRESH_EXPIRES_IN=7d

# Logging & Audit Configuration
LOG_LEVEL=debug
ENABLE_AUDIT_LOGS=true
